[Unit]
Description=roost agent state daemon
Documentation=https://github.com/lost-in-the/roost

# Deliberately NOT ordered against the broker. EMQX is not managed by this
# machine's systemd (it is shared with Home Assistant and Zigbee2MQTT and lives
# elsewhere), so an After= on it could never work. Broker readiness is handled
# in code instead: the daemon reconnects with exponential backoff, indefinitely,
# and publishes nothing until it is genuinely connected.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Work/lost-in-the/roost

# Configuration comes from two files, and the ORDER matters: systemd applies
# EnvironmentFile in sequence, so the credentials file wins on any overlap.
#
#   .env               nine NON-SECRET settings: broker host and port, both
#                      usernames, the topic, the WebSocket URL, the HTTP
#                      bind, and the state source. Gitignored, but nothing
#                      in it is secret.
#
#   credentials.env    the two passwords, 0600, OUTSIDE the repository.
#                      Must be KEY=VALUE, not a raw token — a bare secret in
#                      an EnvironmentFile yields an empty variable silently.
#
# This file is a provisionable CACHE. 1Password remains the source of truth
# (the two Mosquitto items in the Homelab vault); the cache exists so the
# daemon has NO 1Password dependency at boot. Previously this ran under
# `op run --env-file`, which needs an unlocked 1Password session — and there
# is none at boot, so the unit restart-looped until someone logged in.
#
# Restore after an environment reset, while 1Password is unlocked:
#   install -d -m 700 ~/.config/roost && umask 077 && {
#     printf 'ROOST_MQTT_PASSWORD=%s\n' "$(op read 'op://Homelab/Mosquitto - roost daemon/password')";
#     printf 'ROOST_MQTT_RENDERER_PASSWORD=%s\n' "$(op read 'op://Homelab/Mosquitto - roost panel/password')";
#   } > ~/.config/roost/credentials.env
#
# If the cache is missing the daemon refuses to start and prints that command,
# rather than failing later as a bare "not authorized" from the broker.
EnvironmentFile=%h/Work/lost-in-the/roost/.env
EnvironmentFile=%h/.config/roost/credentials.env
ExecStart=/usr/bin/node %h/Work/lost-in-the/roost/daemon/index.js

Restart=always
RestartSec=5s

# Creates and owns %S/roost, the default home of the laptop-open log.
StateDirectory=roost

StandardOutput=journal
StandardError=journal
SyslogIdentifier=roost-daemon

[Install]
WantedBy=default.target
