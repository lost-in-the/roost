# roost daemon configuration.
#
# Copy to .env and fill in. `.env` is gitignored — NEVER commit a real credential.
#
# In production this file holds 1Password SECRET REFERENCES, not secrets. The
# systemd unit runs the daemon under `op run --env-file`, which resolves every
# op:// reference at start and passes the results as ordinary environment
# variables. The daemon itself knows nothing about 1Password.
#
#   op run --env-file=.env -- node daemon/index.js
#
# Check a reference resolves without printing its value:
#   op read "op://Homelab/EMQX roost/password" >/dev/null && echo ok

# ── Broker ───────────────────────────────────────────────────────────────────

# Hostname or IP of the EMQX instance shared with Home Assistant and
# Zigbee2MQTT. Required — the daemon refuses to start without it.
ROOST_MQTT_HOST=emqx.example.internal

# TCP listener the daemon publishes on.
ROOST_MQTT_PORT=1883

# Credentials for the DAEMON, which publishes.
ROOST_MQTT_USER=roost-daemon
ROOST_MQTT_PASSWORD=op://Homelab/EMQX roost daemon/password

# The retained state topic. Every subscriber reads this: the panel, the
# Stream Deck, and Home Assistant later.
ROOST_MQTT_TOPIC=roost/agents/state

# ── Renderer (browser) ───────────────────────────────────────────────────────
#
# The panel is a real MQTT subscriber, which is what lets the broker's Last Will
# reach it directly. Browsers cannot speak MQTT over raw TCP, so it connects
# over WebSocket. EMQX exposes this on 8083 at /mqtt by default.
#
# Derived from ROOST_MQTT_HOST when unset, as ws://<host>:8083/mqtt.
#ROOST_MQTT_WS_URL=ws://emqx.example.internal:8083/mqtt

# A SEPARATE credential for the panel. Strongly recommended: this one is handed
# to a browser page over loopback, so give it an EMQX ACL that allows SUBSCRIBE
# on the state topic and nothing else. It must not be able to publish.
# Falls back to the daemon credentials above when unset.
ROOST_MQTT_RENDERER_USER=roost-panel
ROOST_MQTT_RENDERER_PASSWORD=op://Homelab/EMQX roost panel/password

# ── Local HTTP (renderer host + laptop-open counter) ─────────────────────────

# Loopback only. This serves the renderer and accepts laptop-open taps; it has
# no authentication and must not be exposed off the machine.
ROOST_HTTP_HOST=127.0.0.1
ROOST_HTTP_PORT=8477

# ── Behaviour ────────────────────────────────────────────────────────────────

# Where agent state comes from: `mock` or `openclaw`.
#
# `openclaw` reads real agent presence from the OpenClaw gateway. It requires a
# paired device: run `node scripts/pair-openclaw.mjs` once (see the README). An
# unpaired daemon refuses to start and names that command, rather than reporting
# an empty agent set that would look exactly like "nothing is running".
ROOST_SOURCE=mock

# The OpenClaw gateway's WebSocket URL. Loopback on this host.
#ROOST_OPENCLAW_URL=ws://127.0.0.1:19789

# roost's own device identity and token, mode 0600. NOT a 1Password reference:
# the token is bound to the Ed25519 private key in the same file and is useless
# without it, so a vault would hold half a credential. Losing this file costs
# one re-pair. Defaults to $XDG_STATE_HOME/roost/openclaw-device.json.
#ROOST_OPENCLAW_DEVICE_FILE=/home/you/.local/state/roost/openclaw-device.json

# Which scripted timeline the mock plays: `demo` (loops all states) or
# `death` (kills the daemon mid-run to exercise Last Will).
ROOST_MOCK_SCRIPT=demo

# Publish at least this often, whether or not state changed. Decoupling the
# heartbeat from state change is what makes staleness detectable at all.
ROOST_HEARTBEAT_MS=10000

# The renderer marks itself stale after this long with no message. Must be at
# least twice the heartbeat, so one dropped message is not an alarm; the daemon
# refuses to start otherwise. Unrelated to how long agent turns run — a long
# `thinking` state is NOT stale while heartbeats keep arriving.
ROOST_STALE_MS=30000

# The "had to open the laptop" log. Defaults to
# $XDG_STATE_HOME/roost/laptop-opens.log (~/.local/state/roost/laptop-opens.log).
#ROOST_LAPTOP_LOG=/home/you/.local/state/roost/laptop-opens.log
