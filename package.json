{
  "name": "roost",
  "version": "1.0.0",
  "description": "Ambient agent-presence panel: aggregation daemon + fullscreen web renderer over MQTT.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "accept:m2": "node --test --test-timeout=120000 test/acceptance/m2-approval-browser.test.js",
    "accept:m2:physical": "node scripts/run-m2-physical-acceptance.mjs",
    "capture:panel": "./scripts/capture-panel-states.sh",
    "start": "node daemon/index.js",
    "dev": "ROOST_SOURCE=mock node daemon/index.js",
    "dev:broker": "node scripts/dev-broker.js"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.7.2-beta.7",
    "@openclaw/gateway-protocol": "2026.7.2-beta.7",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "aedes": "^1.1.1",
    "playwright-core": "^1.62.1",
    "ws": "^8.21.3"
  }
}
